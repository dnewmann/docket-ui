{
  "$description": "Layer 3: per-component tokens. Values reference semantic tokens ({color.action.primary}) or primitives for non-color scales ({space.4}). Theme-independent: they resolve through the semantic layer.",
  "button": {
    "radius": "{radius.full}",
    "font-weight": "{font.weight.semibold}",
    "gap": "{space.2}",
    "sm": {
      "height": "36px",
      "padding-x": "{space.4}",
      "font-size": "{font.size.sm}"
    },
    "md": {
      "height": "44px",
      "padding-x": "{space.5}",
      "font-size": "{font.size.sm}"
    },
    "lg": {
      "height": "52px",
      "padding-x": "{space.6}",
      "font-size": "{font.size.md}"
    },
    "primary": {
      "bg": "{color.action.primary}",
      "bg-hover": "{color.action.primary-hover}",
      "bg-active": "{color.action.primary-active}",
      "text": "{color.action.on-primary}"
    },
    "secondary": {
      "bg": "{color.action.secondary}",
      "bg-hover": "{color.action.secondary-hover}",
      "text": "{color.text.primary}",
      "border": "{color.border.default}"
    },
    "ghost": {
      "bg-hover": "{color.action.ghost-hover}",
      "text": "{color.text.primary}"
    },
    "danger": {
      "bg": "{color.action.danger}",
      "bg-hover": "{color.action.danger-hover}",
      "text": "{color.action.on-primary}"
    }
  },
  "field": {
    "height": "48px",
    "radius": "{radius.lg}",
    "padding-x": "{space.4}",
    "font-size": "{font.size.sm}",
    "gap": "{space.1}",
    "bg": "{color.bg.surface}",
    "bg-disabled": "{color.bg.disabled}",
    "text": "{color.text.primary}",
    "placeholder": "{color.text.secondary}",
    "border": "{color.border.input}",
    "border-hover": "{color.text.primary}",
    "border-focus": "{color.focus.ring}",
    "border-error": "{color.status.danger}",
    "label": "{color.text.primary}",
    "label-size": "{font.size.sm}",
    "label-weight": "{font.weight.medium}",
    "hint": "{color.text.secondary}",
    "hint-size": "{font.size.xs}",
    "error": "{color.status.danger}"
  },
  "checkbox": {
    "size": "18px",
    "radius": "{radius.sm}",
    "border": "{color.border.input}",
    "bg": "{color.bg.surface}",
    "checked-bg": "{color.action.primary}",
    "checked-mark": "{color.action.on-primary}"
  },
  "switch": {
    "width": "40px",
    "height": "24px",
    "thumb": "18px",
    "track-off": "{color.border.input}",
    "track-on": "{color.action.primary}",
    "thumb-bg": "{color.bg.surface}"
  },
  "modal": {
    "bg": "{color.bg.surface}",
    "overlay": "{color.bg.overlay}",
    "radius": "{radius.2xl}",
    "shadow": "{shadow.lg}",
    "padding": "{space.6}",
    "width-sm": "400px",
    "width-md": "560px",
    "width-lg": "760px",
    "title-size": "{font.size.xl}"
  },
  "listbox": {
    "bg": "{color.bg.surface}",
    "border": "{color.border.subtle}",
    "radius": "{radius.lg}",
    "shadow": "{shadow.md}",
    "option-hover": "{color.bg.hover}",
    "option-selected": "{color.bg.selected}",
    "option-text": "{color.text.primary}",
    "max-height": "280px"
  },
  "table": {
    "header-bg": "{color.bg.subtle}",
    "header-text": "{color.text.secondary}",
    "border": "{color.border.subtle}",
    "row-hover": "{color.bg.hover}",
    "cell-padding-y": "{space.3}",
    "cell-padding-x": "{space.4}",
    "font-size": "{font.size.sm}"
  },
  "tabs": {
    "gap": "{space.1}",
    "padding-x": "{space.4}",
    "height": "44px",
    "font-size": "{font.size.sm}",
    "font-weight": "{font.weight.semibold}",
    "text": "{color.text.secondary}",
    "text-selected": "{color.text.primary}",
    "indicator": "{color.action.primary}",
    "border": "{color.border.subtle}",
    "bg-hover": "{color.bg.hover}",
    "pill-bg": "{color.bg.subtle}",
    "pill-bg-selected": "{color.action.primary}",
    "pill-text-selected": "{color.action.on-primary}"
  },
  "tooltip": {
    "bg": "{color.bg.inverse}",
    "text": "{color.text.inverse}",
    "radius": "{radius.md}",
    "padding-x": "{space.2}",
    "padding-y": "{space.1}",
    "font-size": "{font.size.xs}",
    "max-width": "240px"
  },
  "stat": {
    "label": "{color.text.secondary}",
    "label-size": "{font.size.sm}",
    "value": "{color.text.primary}",
    "value-size": "{font.size.2xl}",
    "value-weight": "{font.weight.bold}",
    "up": "{color.status.success}",
    "down": "{color.status.danger}",
    "flat": "{color.text.secondary}"
  },
  "badge": {
    "radius": "{radius.full}",
    "padding-x": "{space.2}",
    "font-size": "{font.size.xs}",
    "font-weight": "{font.weight.semibold}"
  },
  "skeleton": {
    "bg": "{color.bg.subtle}",
    "radius": "{radius.md}"
  },
  "card": {
    "bg": "{color.bg.surface}",
    "border": "{color.border.subtle}",
    "radius": "{radius.2xl}",
    "padding": "{space.8}",
    "shadow": "none",
    "bg-feature": "{gradient.feature}"
  },
  "segmented": {
    "bg": "{color.bg.subtle}",
    "bg-selected": "{color.bg.surface}",
    "text": "{color.text.secondary}",
    "text-selected": "{color.text.primary}",
    "radius": "{radius.full}",
    "height": "44px"
  },
  "progress": {
    "track": "{color.bg.subtle}",
    "fill": "{color.action.primary}",
    "height": "8px",
    "radius": "{radius.full}"
  },
  "menu": {
    "bg": "{color.bg.surface}",
    "border": "{color.border.subtle}",
    "radius": "{radius.xl}",
    "item-hover": "{color.bg.hover}",
    "shadow": "{shadow.lg}"
  }
}
