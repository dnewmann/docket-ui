{
  "name": "docket-ui",
  "version": "0.2.0",
  "description": "Docket UI: the design system for Docket, a fictional legal-ops product. React + TypeScript components on a three-layer token architecture.",
  "main": "./dist/docket-ui.js",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && storybook dev -p 6006",
    "build": "npm run tokens && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build -o storybook-static",
    "ci": "npm run contrast && npm run lint && npm run typecheck && npm run test && npm run build && npm run build-storybook",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "author": "Daria Newmann",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnewmann/docket-ui"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/docket-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docket-ui.js"
    },
    "./styles.css": "./dist/docket-ui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "homepage": "https://docket-ui.netlify.app"
}
